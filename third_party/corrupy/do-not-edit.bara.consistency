+  """A pickler which can repickle object hierarchies containing objects created by SafeUnpickler.
+
+  Due to reasons unknown, pythons pickle implementation will normally check if a
+  given class actually matches with the object specified at the __module__ and
+  __name__ of the class. Since this check is performed with object identity
+  instead of object equality we cannot fake this from the classes themselves,
+  and we need to override the method used for normally saving classes.
+  """
+
+  def save_global(self, obj, name=None, pack=None):
+    if isinstance(obj, FakeClassType):
+      if PY2:
+        self.write(pickle.GLOBAL + obj.__module__ + "\n" + obj.__name__ + "\n")
+      elif self.proto >= 4:
+        self.save(obj.__module__)
+        self.save(obj.__name__)
+        self.write(pickle.STACK_GLOBAL)
+      else:
+        self.write(
+            pickle.GLOBAL
+            + (obj.__module__ + "\n" + obj.__name__ + "\n").decode("utf-8")
+        )
+      self.memoize(obj)
+      return
 
